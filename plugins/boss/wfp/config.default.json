{
  "defaultProfile": null,
  "_doc": "Shipped wfp defaults; replaced on plugin update, so do not edit this file. Put your own settings in wfp.json in the boss data dir (node lib/paths.js prints it): top-level keys replace these, and object values (profiles, typeRoles, ultracodeRaise) merge one level deep, so a profile you define replaces the whole shipped profile of that name. defaultProfile null = ask once per session; `node wfp/wfp.js default <profile>` stores a lasting default in wfp.json. profiles.<name>.roles.<role> = {model, effort}: the bar, the default AND the minimum for that role. belowBarAllowed = roles whose clearly mechanical rows may go below the bar. ultracodeRaise = the preset one step up while `wfp.js ultracode on`. No preset sets askBeforeOpus (presets are floors); `set askBeforeOpus=true` is a per-session opt-in. correctionMode = how a missing model/effort is corrected on an Agent launch: \"deny\" (deny-with-correction) or \"updatedInput\" (rewrite the call in place). typeRoles keys are base agent names; a plugin prefix (boss:orch-builder) is stripped before the lookup.",
  "telemetryFreshSec": 300,
  "contextCheckpointsTokens": [150000, 250000, 400000],
  "contextCheckpointPctOfWindow": 70,
  "warnCooldownSec": 1200,
  "warnMinGrowthTokens": 40000,
  "stateTtlDays": 7,
  "activeAgentStaleSec": 1800,
  "preflightAfterUnpolicedLaunches": 3,
  "lightAgentTypes": ["Explore", "Plan", "claude-code-guide", "statusline-setup"],
  "denyStreakLimit": 2,
  "correctionMode": "updatedInput",
  "barNoteMaxPerSession": 6,
  "typeRoles": {
    "orch-planner": "planning",
    "orch-plan-checker": "plan-check",
    "orch-scout": {"role": "discovery", "byDescription": [{"match": "diagnos|debug|root.?cause", "role": "diagnosis"}]},
    "orch-builder": "implementation",
    "orch-reviewer": "review"
  },
  "roles": [
    {"role": "plan-check", "match": "plan-?check"},
    {"role": "review", "match": "review|verif|checker|audit|test-automator|qa-"},
    {"role": "diagnosis", "match": "debug|diagnos|root.?cause"},
    {"role": "planning", "match": "plan|architect|design|roadmap|synthesi"},
    {"role": "discovery", "match": "explore|research|investigat|search|scope-discover|mapper|analy[sz]er|guide|intel|scout"},
    {"role": "implementation", "match": "executor|developer|implement|fixer|engineer|writer|builder|-pro$"}
  ],
  "ultracodeRaise": {"economy": "balanced", "balanced": "quality", "quality": "max", "max": "max"},
  "profiles": {
    "economy": {
      "roles": {
        "planning":       {"model": "sonnet", "effort": "high"},
        "plan-check":     {"model": "sonnet", "effort": "low"},
        "discovery":      {"model": "haiku",  "effort": "low"},
        "implementation": {"model": "sonnet", "effort": "medium"},
        "diagnosis":      {"model": "sonnet", "effort": "medium"},
        "review":         {"model": "sonnet", "effort": "medium"},
        "default":        {"model": "sonnet", "effort": "medium"}
      },
      "belowBarAllowed": ["planning", "plan-check", "discovery", "implementation", "diagnosis", "review", "default"],
      "maxConcurrent": 2, "maxLaunches": 4, "askBeforeOpus": false
    },
    "balanced": {
      "roles": {
        "planning":       {"model": "opus",   "effort": "medium"},
        "plan-check":     {"model": "sonnet", "effort": "medium"},
        "discovery":      {"model": "haiku",  "effort": "low"},
        "implementation": {"model": "sonnet", "effort": "medium"},
        "diagnosis":      {"model": "sonnet", "effort": "medium"},
        "review":         {"model": "sonnet", "effort": "high"},
        "default":        {"model": "sonnet", "effort": "medium"}
      },
      "belowBarAllowed": ["planning", "plan-check", "discovery", "implementation", "diagnosis", "review", "default"],
      "maxConcurrent": 3, "maxLaunches": 8, "askBeforeOpus": false
    },
    "quality": {
      "roles": {
        "planning":       {"model": "opus",   "effort": "medium"},
        "plan-check":     {"model": "opus",   "effort": "medium"},
        "discovery":      {"model": "haiku",  "effort": "medium"},
        "implementation": {"model": "sonnet", "effort": "high"},
        "diagnosis":      {"model": "sonnet", "effort": "medium"},
        "review":         {"model": "opus",   "effort": "medium"},
        "default":        {"model": "opus",   "effort": "medium"}
      },
      "belowBarAllowed": ["planning", "plan-check", "discovery", "implementation", "diagnosis", "review", "default"],
      "maxConcurrent": 4, "maxLaunches": 12, "askBeforeOpus": false
    },
    "max": {
      "roles": {
        "planning":       {"model": "opus",   "effort": "xhigh"},
        "plan-check":     {"model": "opus",   "effort": "xhigh"},
        "discovery":      {"model": "sonnet", "effort": "medium"},
        "implementation": {"model": "opus",   "effort": "high"},
        "diagnosis":      {"model": "opus",   "effort": "xhigh"},
        "review":         {"model": "opus",   "effort": "xhigh"},
        "default":        {"model": "opus",   "effort": "high"}
      },
      "belowBarAllowed": ["plan-check", "discovery", "implementation", "diagnosis", "default"],
      "maxConcurrent": 4, "maxLaunches": 16, "askBeforeOpus": false
    }
  }
}
